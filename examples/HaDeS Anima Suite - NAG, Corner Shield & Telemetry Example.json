      "inputs": [],
      "outputs": [],
      "properties": {},
      "widgets_values": [
        "Attention Guidance (NAG) adds negative guidance inside attention. The Aesthetic Crispness preset works with normal CFG; the Turbo / Lightning preset restores the negative prompt at CFG 1.0.\n\nCorner Shield looks for scribbles / signatures in the image corners (here the bottom two) and blends them away; Mask Only just reports what it found.\n\nSuite Telemetry collects the info outputs of up to 8 HaDeS nodes and checks them together: flow shift mismatches, CFG vs NAG, 16px grid, llm_adapter protection, VAE channels."
      ],
      "widgets_values_named": {
        "text": "Attention Guidance (NAG) adds negative guidance inside attention. The Aesthetic Crispness preset works with normal CFG; the Turbo / Lightning preset restores the negative prompt at CFG 1.0.\n\nCorner Shield looks for scribbles / signatures in the image corners (here the bottom two) and blends them away; Mask Only just reports what it found.\n\nSuite Telemetry collects the info outputs of up to 8 HaDeS nodes and checks them together: flow shift mismatches, CFG vs NAG, 16px grid, llm_adapter protection, VAE channels."
      },
      "color": "#432",
      "bgcolor": "#653"
    }
